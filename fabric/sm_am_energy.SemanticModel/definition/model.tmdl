model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - lh_energy"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit"]

ref table dim_date
ref table dim_machine
ref table dim_state
ref table dim_tariff
ref table dim_time_slot
ref table fact_build_job
ref table fact_data_quality_daily
ref table fact_energy_15min
ref table fact_heatup
ref table fact_state_energy

