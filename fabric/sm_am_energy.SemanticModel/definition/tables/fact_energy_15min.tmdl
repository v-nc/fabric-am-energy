		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Peak_share = DIVIDE ( CALCULATE ( [Energy_kWh], dim_tariff[tariff_band] = "peak" ), [Energy_kWh] )
