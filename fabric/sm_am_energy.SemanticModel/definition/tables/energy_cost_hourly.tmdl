table energy_cost_hourly
	lineageTag: ca928ad7-7eb9-4634-a787-fc71e8d8e1f8
	sourceLineageTag: [mart].[energy_cost_hourly]

	/// Energy at the hourly day-ahead price (energy component only, without grid fees and levies)
	measure Day_ahead_cost = SUM ( energy_cost_hourly[cost_spot_eur] )
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Market prices
		lineageTag: 626b919c-9b27-499f-b74c-a01c9cdca6a4

	measure Market_kWh = SUM ( energy_cost_hourly[kwh] )
		formatString: #,0
		isHidden
		displayFolder: Market prices
		lineageTag: c58252b9-fc25-4f5d-a00b-b99ee5240a0f

	/// Load-weighted day-ahead price: what the park's consumption profile paid per MWh
	measure Park_price_EUR_MWh = DIVIDE ( [Day_ahead_cost], [Market_kWh] ) * 1000
		formatString: #,0.0
		displayFolder: Market prices
		lineageTag: fd318d7c-b479-4cd7-90e7-240934b7b6e1

	/// Time-weighted day-ahead price: the plain average over the hours in the filter
	measure Market_price_EUR_MWh = AVERAGEX ( VALUES ( energy_cost_hourly[hour_start_utc] ), CALCULATE ( MAX ( energy_cost_hourly[spot_eur_mwh] ) ) )
		formatString: #,0.0
		displayFolder: Market prices
		lineageTag: e89320de-38e8-48be-8a8e-48e94b9a8d0b

	/// How much more (or less) than the market average the park's load profile pays
	measure Load_profile_premium = DIVIDE ( [Park_price_EUR_MWh], [Market_price_EUR_MWh] ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Market prices
		lineageTag: e422983d-6b41-4be2-88ee-acff57c00f38

	/// Average power of the 3D printers in the filter, in kW (kWh per hour)
	measure Avg_park_power_kW = DIVIDE ( [Market_kWh], DISTINCTCOUNT ( energy_cost_hourly[hour_start_utc] ) )
		formatString: #,0.0
		displayFolder: Market prices
		lineageTag: b3a82193-117d-4420-988a-d33e64ea4c97

	/// Hours with a negative day-ahead price
	measure Negative_price_hours = CALCULATE ( DISTINCTCOUNT ( energy_cost_hourly[hour_start_utc] ), KEEPFILTERS ( energy_cost_hourly[spot_eur_mwh] < 0 ) )
		formatString: #,0
		displayFolder: Market prices
		lineageTag: 7331469b-b5eb-4417-a299-6bb6fa2d9508

	/// Energy consumed while the day-ahead price was negative
	measure kWh_at_negative_price = CALCULATE ( [Market_kWh], KEEPFILTERS ( energy_cost_hourly[spot_eur_mwh] < 0 ) )
		formatString: #,0
		displayFolder: Market prices
		lineageTag: 9af243f1-21cb-43c8-a958-2bd2c9d4a25b

