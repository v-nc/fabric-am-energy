# Copy to .env and fill in. .env is git-ignored: never commit it.

# Where the gateway sends events: "file" (JSON lines inside the gateway volume) or "eventhubs" (Fabric Eventstream).
SINK=file

# Fabric Eventstream > custom endpoint source > Event Hub protocol > SAS key authentication > connection string.
# It includes EntityPath. If it ever leaks, regenerate the key in Eventstream.
EVENTSTREAM_CONNECTION_STRING=

# 1 = original event schema, 2 = adds power_factor (the mid-history schema change).
SCHEMA_VERSION=1

# 1 = real-time job cycles. 0.0333 makes them 30 times faster for a live demo.
DURATION_SCALE=1

# Demo mode for a live presentation (leave empty for normal behaviour). With DURATION_SCALE=0.0333 a 2 h heat-up takes
# 4 minutes; these make overruns frequent and idle gaps short, so the real-time alert fires within minutes.
HEATUP_OVERRUN_PROBABILITY=
IDLE_BETWEEN_JOBS_H=
